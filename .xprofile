# Suckless Environment v2
# dmenu-clip/dmenu-clipd are native C utilities — no clipmenul config needed
#
# Sourced by the display manager (ly) before exec'ing dwm-start, so these
# exports reach dwm and every child app. The base keyboard layout is pinned
# at the X-server level by /etc/X11/xorg.conf.d/00-keyboard.conf (installed by
# install.sh), so no setxkbmap is needed here.

# Route GTK/Qt/X11 apps through the fcitx5 input method (mozc, etc.).
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
