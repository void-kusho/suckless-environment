#
# ~/.bashrc -- interactive shell configuration, deployed by home.scm's
# home-bash-service-type (the file itself guards non-interactive runs).
#

# Not interactive = bail
[[ $- != *i* ]] && return

# --- History ---
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T '
shopt -s histappend
PROMPT_COMMAND='history -a'

# --- Shell options ---
shopt -s checkwinsize globstar autocd cdspell dirspell nocaseglob

# --- Colors (Tokyo Night) ---
alias ls='ls --color=auto'
alias ll='ls -lh --color=auto'
alias la='ls -lah --color=auto'
alias grep='grep --color=auto'
alias diff='diff --color=auto'

# Tokyo Night grep match = red #f7768e
export GREP_COLORS='ms=38;2;247;118;142:mc=38;2;247;118;142:sl=:cx=:fn=38;2;122;162;247:ln=38;2;224;175;104:bn=38;2;224;175;104:se=38;2;86;95;137'
# Tokyo Night LS_COLORS
export LS_COLORS='di=38;2;122;162;247:ln=38;2;125;207;255:ex=38;2;158;206;106:*.tar=38;2;247;118;142:*.zip=38;2;247;118;142:*.gz=38;2;247;118;142:*.md=38;2;224;175;104:*.json=38;2;224;175;104:*.sh=38;2;158;206;106'

# --- Editor: Doom Emacs ---
# emacsclient reuses a running daemon when there is one and falls back to a
# fresh `emacs' otherwise, so this works with or without `emacs --daemon'.
# `et' is the same idea in the terminal: -t asks the daemon for a TTY frame,
# and the fallback keeps -nw so it can never open a window. Doom's :os tty
# module is what makes that frame worth using.
alias e='emacsclient -a emacs'
alias et='emacsclient -t -a "emacs -nw"'
alias doom="$HOME/.config/emacs/bin/doom"

# --- Safety ---
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# --- Navigation ---
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias modrinth='flatpak run com.modrinth.ModrinthApp'

# --- Prompt: user@host cwd (git-branch) $  —  Tokyo Night ---
# green #9ece6a, blue #7aa2f7, yellow #e0af68, magenta #bb9af7, fg #c0caf5
parse_git_branch() {
    git branch 2>/dev/null | sed -n 's/^\* \(.*\)/ (\1)/p'
}
PS1='\[\e[38;2;158;206;106m\]\u@\h\[\e[0m\] \[\e[38;2;122;162;247m\]\W\[\e[38;2;224;175;104m\]$(parse_git_branch)\[\e[0m\] \[\e[38;2;187;154;247m\]\$\[\e[0m\] '

# --- Completion ---
[ -f /etc/bash_completion ] && . /etc/bash_completion

# --- Paths ---

# --- Editor ---
export EDITOR='emacsclient -a emacs'
export VISUAL="$EDITOR"

# --- Greeting on a new st terminal ---
# fastfetch first: nixpkgs dropped neofetch as unmaintained, while Guix and
# Artix still carry it. Trying both keeps this file identical across branches.
# neofetch on Artix/Guix; neowofetch (the maintained fork, same config file)
# on NixOS, which dropped neofetch. Trying all three keeps this file identical
# across branches.
if [ "$TERM" = "st-256color" ]; then
    for _f in neofetch neowofetch fastfetch; do
        if command -v "$_f" >/dev/null 2>&1; then "$_f"; break; fi
    done
    unset _f
fi

# --- Per-user toolchains (present only if you installed them) ---
[ -f "$HOME/.deno/env" ] && . "$HOME/.deno/env"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
