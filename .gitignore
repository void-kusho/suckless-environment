# Build artifacts. The vendored Makefiles build in place, so every one of
# these lands next to its sources -- and `src = ../dwm` in nix/packages.nix
# would copy it into the store, where make skips the compile and installs a
# binary built for another distribution. nix/lib.nix runs `make clean` and
# checks the interpreter to catch that; these entries stop it at the door.
*.o
*.orig
*.rej
dwm/dwm
dmenu/dmenu
dmenu/stest
st/st
slstatus/slstatus
utils/battery-notify/battery-notify
utils/brightness-notify/brightness-notify
utils/dmenu-clip/dmenu-clip
utils/dmenu-clipd/dmenu-clipd
utils/dmenu-cpupower/dmenu-cpupower
utils/dmenu-session/dmenu-session
# `make test' in utils/ links the two suites at the top of that directory.
utils/test-util
utils/test-dmenu

# These utilities carry no config.h on this branch -- their backends are in
# the .c files. The entries below only stop the guix branch's generated
# copies from being committed here after a branch switch.
utils/dmenu-session/config.h
utils/dmenu-cpupower/config.h

# nix build output symlinks: `result', and `result-<output>' when a
# derivation has more than one.
result
result-*

# QEMU writes the VM's disk into the current directory when you `nix run .#vm'
# from here. It is regenerated on every run and must never be committed.
*.qcow2
