*.rej
result
result-
utils/brightness-notify/brightness-notify
utils/*/test-*
tests/test-*

# These utilities carry no config.h on this branch -- their backends are in
# the .c files. The entries below only stop the guix branch's generated
# copies from being committed here after a branch switch.
utils/dmenu-session/config.h
utils/dmenu-cpupower/config.h

# nix build output symlink
result

# QEMU writes the VM's disk into the current directory when you `nix run .#vm'
# from here. It is regenerated on every run and must never be committed.
*.qcow2
