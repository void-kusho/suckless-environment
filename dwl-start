#!/bin/sh
# dwl-start — launch a dwl (Wayland) session.
#
# Wayland analog of dwm-start: set the Wayland environment, source the
# per-machine autostart hook (~/.config/suckless/autostart.sh), start the
# session daemons, and exec dwl with the status script piped to stdin.
#
# The Guix path (greetd/tuigreet -> dwl-session) achieves the same via a
# packaged session; this script is the install.sh / manual entry point.

export PATH="$HOME/.local/bin:$PATH"

# Wayland environment
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=dwl
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
# Input method (fcitx5); XMODIFIERS is only used over XWayland fallback.
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx

# Per-machine monitor layout & wallpaper (wlr-randr, swaybg) live in the
# autostart hook, never here.
AUTOSTART="$HOME/.config/suckless/autostart.sh"
if [ -f "$AUTOSTART" ]; then
    . "$AUTOSTART"
fi

# Launcher polkit agent (lxpolkit if present, else fallbacks)
if command -v lxpolkit >/dev/null 2>&1; then
    lxpolkit &
elif [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
elif [ -x /run/current-system/profile/libexec/polkit-mate-authentication-agent-1 ]; then
    /run/current-system/profile/libexec/polkit-mate-authentication-agent-1 &
fi

fcitx5 -d
dmenu-clipd &
dunst &

# Audio stack (no service manager starts these on this setup)
pipewire &
pipewire-pulse &
wireplumber &

# Battery monitor (30 second tick)
while true; do
    battery-notify
    sleep 30
done &

# Idle handling: lock after 10 minutes of inactivity
swayidle -w timeout 600 'swaylock' &

# Feed dwl with the status bar (stdin -> dwl's statusline)
dwl-status.sh | dwl
