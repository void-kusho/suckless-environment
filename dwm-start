#!/bin/sh

export PATH="$HOME/.local/bin:$PATH"
# Guix: the session SLiM starts does not inherit the system profile, and the
# suckless tools live there.  No-op on Arch/Artix.
[ -d /run/current-system/profile/bin ] && \
    export PATH="$PATH:/run/current-system/profile/bin"

# dmenu_path_desktop scans $XDG_DATA_DIRS/applications, and its built-in
# default (/usr/local/share:/usr/share) does not exist on Guix -- Super+d
# would list nothing at all.  Point it at the Guix profiles.
if [ -d /run/current-system/profile/share ]; then
    export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    XDG_DATA_DIRS="$HOME/.guix-home/profile/share:$HOME/.guix-profile/share:/run/current-system/profile/share:$XDG_DATA_DIRS"
    export XDG_DATA_DIRS
fi

# Source system xinitrc scripts
if [ -d /etc/X11/xinit/xinitrc.d ] ; then
    for f in /etc/X11/xinit/xinitrc.d/?*.sh ; do
        [ -x "$f" ] && . "$f"
    done
    unset f
fi

# Input method (fcitx5 + anthy).  These used to live in ~/.xprofile, which
# only ever had one reader: this script.  Sourcing .xprofile is an
# Arch/Debian display-manager convention that Guix's SLiM does not follow, so
# the file bought an indirection and nothing else.  The base keyboard layout
# comes from the X server itself (xorg-configuration in guix/system.scm).
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx

# Display: DP-1 primary @180Hz (right), laptop eDP-1 @60Hz (left).
# --primary makes DP-1 Xinerama monitor 0, so dwm starts focused on it.
# (lxrandr saved this to ~/.config/autostart, but nothing runs autostart on dwm.)
xrandr --output eDP-1 --mode 1920x1080 --rate 60 --pos 0x0 \
       --output DP-1 --primary --mode 1920x1080 --rate 180 --pos 1920x0
# Warp pointer onto DP-1 so the first EnterNotify keeps focus there too.
xdotool mousemove 2880 540

# Launch polkit agent — try lxpolkit first, fall back to alternatives
if command -v lxpolkit >/dev/null 2>&1; then
    lxpolkit &
elif [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
elif [ -x /run/current-system/profile/libexec/polkit-mate-authentication-agent-1 ]; then
    /run/current-system/profile/libexec/polkit-mate-authentication-agent-1 &
fi
fcitx5 -d
dmenu-clipd &
dunst &

# Audio stack (no service manager starts these on this setup)
# Audio is a Guix Home Shepherd service (home-pipewire-service-type).
# Starting the daemons here as well would race it, and on Guix these binaries
# are not even on the session PATH -- Shepherd owns them.

# Pre-warm the flameshot daemon so the Print-key `flameshot gui` always
# hits a live daemon (cold dbus-activation races and the overlay never opens).
flameshot &

# Battery monitor (30 second tick)
while true; do
    battery-notify
    sleep 30
done &

# Start status bar
while true; do
    slstatus
    sleep 1
done &

feh --no-fehbg --bg-fill ~/wallpapers/sushi_original.png &
exec dwm
